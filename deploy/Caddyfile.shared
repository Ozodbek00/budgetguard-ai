# Site block to append to an EXISTING Caddyfile on a host where Caddy already
# fronts other sites. Do not use this as a whole Caddyfile.
#
# Caddy reaches the app by container name over the shared Docker network, so
# the app publishes no host ports. The certificate is issued automatically on
# first request, once budgetguard-ai.proread.uz resolves to this server.
#
# After appending, validate before reloading — a syntax error here would take
# down every other site this Caddy serves, not just this one:
#
#   docker exec profin-caddy-1 caddy validate --config /etc/caddy/Caddyfile
#   docker exec profin-caddy-1 caddy reload  --config /etc/caddy/Caddyfile

budgetguard-ai.proread.uz {
	# Blazor Server keeps a WebSocket open per connected client. Caddy upgrades
	# these automatically, but the timeouts matter: an auditor can sit reading a
	# long anomaly report without sending a request, and a short idle timeout
	# would drop the circuit and blank the page.
	reverse_proxy budgetguard-web:8080 {
		flush_interval -1
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file /data/budgetguard-access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}
