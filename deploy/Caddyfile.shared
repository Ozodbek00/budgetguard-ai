# Site block to append to an EXISTING Caddyfile on a host where Caddy already
# fronts other sites. Do not use this as a whole Caddyfile.
#
# Caddy reaches the app by container name over the shared Docker network, so
# the app publishes no host ports. The certificate is issued automatically on
# first request, once budgetguard-ai.proread.uz resolves to this server.
#
# After appending, validate before reloading — a syntax error here would take
# down every other site this Caddy serves, not just this one:
#
#   docker exec profin-caddy-1 caddy validate --config /etc/caddy/Caddyfile
#   docker exec profin-caddy-1 caddy reload  --config /etc/caddy/Caddyfile

budgetguard-ai.proread.uz {
	# Optional access gate for pre-release sharing. Generate the hash with:
	#   docker exec <caddy-container> caddy hash-password --plaintext '<password>'
	# and paste the RESULT here. Never commit the plaintext, and note the hash
	# below is a placeholder — replace it before enabling.
	#
	# /health is deliberately left open so uptime checks and container platforms
	# are not tripped by a 401.
	#
	# This works with Blazor Server: after the browser satisfies the initial
	# challenge it replays the credentials on the /_blazor WebSocket handshake,
	# so the circuit establishes normally. (Verified — but note that testing
	# this by putting credentials in the URL as https://user:pass@host will
	# appear to fail, because fetch() refuses to construct requests from a
	# credentialed URL. That is a artefact of the test, not of the gate.)
	@needs_auth not path /health
	basic_auth @needs_auth {
		judge $2a$14$REPLACE.WITH.YOUR.OWN.BCRYPT.HASH.FROM.CADDY.HASH.PASSWORD
	}

	# Blazor Server keeps a WebSocket open per connected client. Caddy upgrades
	# these automatically, but the timeouts matter: an auditor can sit reading a
	# long anomaly report without sending a request, and a short idle timeout
	# would drop the circuit and blank the page.
	reverse_proxy budgetguard-web:8080 {
		flush_interval -1
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file /data/budgetguard-access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}

# The API and its Swagger UI, on a separate hostname rather than a path under
# the app. A path prefix would be tidier to link but wrong here: the two
# containers keep separate databases, so /api under the app's hostname would
# answer with a different dataset than the page above it — the kind of
# inconsistency that makes a reviewer distrust everything else on the screen.
budgetguard-api.proread.uz {
	reverse_proxy budgetguard-api:8080

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
