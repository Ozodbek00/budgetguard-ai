@page "/how-it-works"
@using Markdig
@inject IWebHostEnvironment Environment
@inject ILogger<HowItWorks> Logger
@inject IUiText T

<PageTitle>BudgetGuard AI — @T.NavHowItWorks</PageTitle>

<div class="bg-page-head">
    <div>
        <h1>@T.HowItWorksTitle</h1>
        <p class="bg-muted">
            @T.HowItWorksSubtitle
        </p>
    </div>
</div>

@* No "this page renders a markdown file" note here on purpose.

   How the content is sourced is a fact about the build, interesting to a
   contributor and irrelevant to the auditor reading the page. It is documented
   in docs/CODING_STANDARDS.md and README.md, where the audience is right. *@

@if (T.LanguageTag != "en")
{
    <div class="bg-banner bg-banner-synthetic">@T.MethodologyEnglishOnly</div>
}

<section class="bg-card">
    @if (_html is null)
    {
        <p class="bg-muted">@T.Loading</p>
    }
    else
    {
        <article class="bg-prose">
            @((MarkupString)_html)
        </article>
    }
</section>

@code {
    private string? _html;

    protected override void OnInitialized()
    {
        // The linked content file lands next to the assembly, which is the
        // output directory under `dotnet run` and /app in the container.
        // ContentRootPath points at the project folder in development, where
        // the file does not exist, so it is only a fallback.
        var candidates = new[]
        {
            Path.Combine(AppContext.BaseDirectory, "Content", "DETECTION_METHODOLOGY.md"),
            Path.Combine(Environment.ContentRootPath, "Content", "DETECTION_METHODOLOGY.md")
        };

        var path = candidates.FirstOrDefault(File.Exists);

        if (path is null)
        {
            Logger.LogWarning(
                "Methodology document not found. Looked in: {Paths}.", string.Join("; ", candidates));

            _html = "<p>" + System.Net.WebUtility.HtmlEncode(T.MethodologyUnavailable) + "</p>";
            return;
        }

        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .DisableHtml()
            .Build();

        // DisableHtml above matters: the rendered output is injected as a
        // MarkupString, which bypasses Blazor's encoding. The source is a
        // repository file rather than user input, but a document that becomes
        // editable later should not silently become an XSS vector.
        _html = Markdown.ToHtml(File.ReadAllText(path), pipeline);
    }
}
