@page "/report"
@inject ISender Sender
@inject IUiText T
@inject BudgetGuard.Domain.Detection.Explanations.IExplanationWriter Writer

<PageTitle>BudgetGuard AI — @T.ReportTitle</PageTitle>

@if (_error is not null)
{
    <div class="bg-banner bg-banner-error">
        <strong>@T.NoDatasetTitle</strong> @_error
        <a href="">@T.LoadDatasetFirst</a>
    </div>
}
else if (_report is null)
{
    <p class="bg-muted">@T.Loading</p>
}
else
{
    <SyntheticDataBanner IsSyntheticDemo="_report.IsSyntheticDemo" />

    <div class="bg-page-head">
        <div>
            <h1>@T.ReportTitle</h1>
            <p class="bg-muted">
                @_report.DatasetName — @T.TransactionsAnalysed(_report.TransactionCount),
                @_report.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC
            </p>
        </div>
    </div>

    <div class="bg-stats">
        <div class="bg-stat bg-sev-critical">
            <span class="bg-stat-value">@_report.Summary.Critical</span>
            <span class="bg-stat-label">@T.SeverityCritical</span>
        </div>
        <div class="bg-stat bg-sev-high">
            <span class="bg-stat-value">@_report.Summary.High</span>
            <span class="bg-stat-label">@T.SeverityHigh</span>
        </div>
        <div class="bg-stat bg-sev-medium">
            <span class="bg-stat-value">@_report.Summary.Medium</span>
            <span class="bg-stat-label">@T.SeverityMedium</span>
        </div>
        <div class="bg-stat bg-sev-low">
            <span class="bg-stat-value">@_report.Summary.Low</span>
            <span class="bg-stat-label">@T.SeverityLow</span>
        </div>
        <div class="bg-stat bg-stat-accent">
            <span class="bg-stat-value">@_report.Summary.Corroborated</span>
            <span class="bg-stat-label">@T.Corroborated</span>
        </div>
    </div>

    <section class="bg-card">
        <div class="bg-filters">
            <label>
                @T.FilterCategory
                <select @bind="_category" @bind:after="ReloadAsync">
                    <option value="">@T.FilterAllCategories</option>
                    @foreach (var category in _allCategories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </label>

            <label>
                @T.FilterDepartment
                <select @bind="_department" @bind:after="ReloadAsync">
                    <option value="">@T.FilterAllDepartments</option>
                    @foreach (var department in _allDepartments)
                    {
                        <option value="@department">@department</option>
                    }
                </select>
            </label>

            <label>
                @T.FilterSeverity
                <select @bind="_minimumSeverity" @bind:after="ReloadAsync">
                    <option value="">@T.FilterAny</option>
                    <option value="@Severity.Medium">@T.FilterMediumAbove</option>
                    <option value="@Severity.High">@T.FilterHighAbove</option>
                    <option value="@Severity.Critical">@T.FilterCriticalOnly</option>
                </select>
            </label>

            <span class="bg-muted bg-filter-note">
                @T.FilterNote
            </span>
        </div>

        @if (_report.Findings.Count == 0)
        {
            <p class="bg-muted">
                @T.NoFindings
            </p>
        }
        else
        {
            <table class="bg-table bg-table-findings">
                <thead>
                    <tr>
                        <th>@T.ColSeverity</th>
                        <th>@T.ColSubject</th>
                        <th>@T.ColCategoryDepartment</th>
                        <th class="bg-num">@T.ColAmount</th>
                        <th class="bg-num">@T.ColRisk</th>
                        <th>@T.ColWhyFlagged</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var finding in _report.Findings)
                    {
                        <tr>
                            <td>
                                <span class="bg-pill @SeverityClass(finding.Severity)">@SeverityLabel(finding.Severity)</span>
                                @if (finding.IsCorroborated)
                                {
                                    <span class="bg-tag bg-tag-corroborated" title="Independent methods agree">
                                        @T.MethodsCount(finding.Detectors.Count)
                                    </span>
                                }
                            </td>
                            <td>
                                <strong>@finding.SubjectLabel</strong>
                                <div class="bg-muted bg-small">@SubjectLabel(finding.SubjectType)</div>
                            </td>
                            <td class="bg-muted bg-small">
                                @(finding.Category ?? "—")
                                @if (!string.IsNullOrEmpty(finding.Department))
                                {
                                    <div>@finding.Department</div>
                                }
                            </td>
                            <td class="bg-num">
                                @(finding.Amount.HasValue ? finding.Amount.Value.ToString("N0") : "—")
                                @if (finding.TransactionDate.HasValue)
                                {
                                    <div class="bg-muted bg-small">
                                        @finding.TransactionDate.Value.ToString("yyyy-MM-dd")
                                    </div>
                                }
                            </td>
                            <td class="bg-num">@finding.RiskScore.ToString("F2")</td>
                            <td class="bg-explanation">
                                @foreach (var signal in finding.Signals)
                                {
                                    <details>
                                        <summary>
                                            <span class="bg-detector">@DetectorLabel(signal.Detector)</span>
                                            @signal.Explanation
                                        </summary>
                                        <dl class="bg-evidence">
                                            @foreach (var item in signal.Evidence)
                                            {
                                                <div>
                                                    <dt>@item.Key</dt>
                                                    <dd>@item.Value</dd>
                                                </div>
                                            }
                                        </dl>
                                    </details>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "datasetId")]
    private Guid? DatasetId { get; set; }

    private AnomalyReportDto? _report;
    private string? _error;

    private string _category = string.Empty;
    private string _department = string.Empty;
    private string _minimumSeverity = string.Empty;

    // Held separately so narrowing the filters cannot progressively empty the
    // dropdowns that produced the current view.
    private IReadOnlyList<string> _allCategories = [];
    private IReadOnlyList<string> _allDepartments = [];

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();

        if (_report is not null)
        {
            _allCategories = _report.Categories;
            _allDepartments = _report.Departments;
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            _error = null;

            Severity? severity = string.IsNullOrEmpty(_minimumSeverity)
                ? null
                : Enum.Parse<Severity>(_minimumSeverity);

            _report = await Sender.Send(new GetAnomalyReportQuery(
                DatasetId,
                string.IsNullOrEmpty(_category) ? null : _category,
                string.IsNullOrEmpty(_department) ? null : _department,
                severity));
        }
        catch (BudgetGuard.Application.Common.Exceptions.NotFoundException)
        {
            _error = T.NoDatasetBody;
        }
    }

    private static string SeverityClass(string severity) => severity switch
    {
        nameof(Severity.Critical) => "bg-sev-critical",
        nameof(Severity.High) => "bg-sev-high",
        nameof(Severity.Medium) => "bg-sev-medium",
        _ => "bg-sev-low"
    };

    private string DetectorLabel(string detector) =>
        Enum.TryParse<DetectorKind>(detector, out var kind)
            ? Writer.DetectorName(kind)
            : detector;

    private string SeverityLabel(string severity) => severity switch
    {
        nameof(Severity.Critical) => T.SeverityCritical,
        nameof(Severity.High) => T.SeverityHigh,
        nameof(Severity.Medium) => T.SeverityMedium,
        _ => T.SeverityLow
    };

    private string SubjectLabel(string subjectType) => subjectType switch
    {
        nameof(AnomalySubjectType.Transaction) => T.SubjectTransaction,
        nameof(AnomalySubjectType.Vendor) => T.SubjectVendor,
        _ => T.SubjectDataset
    };
}
