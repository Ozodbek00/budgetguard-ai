@page "/benford"
@inject ISender Sender
@inject IUiText T

<PageTitle>BudgetGuard AI — @T.NavBenford</PageTitle>

@if (_error is not null)
{
    <div class="bg-banner bg-banner-error">
        <strong>@T.NoDatasetTitle</strong> @_error <a href="">@T.LoadDatasetFirst</a>
    </div>
}
else if (_distribution is null)
{
    <p class="bg-muted">@T.Loading</p>
}
else
{
    <SyntheticDataBanner IsSyntheticDemo="_distribution.IsSyntheticDemo" />

    <div class="bg-page-head">
        <div>
            <h1>@T.BenfordTitle</h1>
            <p class="bg-muted">@_distribution.PopulationLabel — @T.BenfordAmountsTested(_distribution.SampleSize)</p>
        </div>
    </div>

    <div class="bg-verdict @(_distribution.IsAnomalous ? "bg-verdict-bad" : "bg-verdict-ok")">
        <strong>@(_distribution.IsAnomalous ? T.BenfordDoesNotConform : T.BenfordConforms)</strong>
        — @_distribution.Explanation
    </div>

    <section class="bg-card">
        <BenfordChart Digits="_distribution.Digits" SampleSize="_distribution.SampleSize" />
    </section>

    <div class="bg-grid-2">
        <section class="bg-card">
            <h2>@T.BenfordStatistics</h2>
            <table class="bg-table">
                <tbody>
                    <tr>
                        <td>@T.BenfordMad</td>
                        <td class="bg-num"><strong>@_distribution.MeanAbsoluteDeviation.ToString("F4")</strong></td>
                    </tr>
                    <tr>
                        <td>
                            @T.BenfordThresholdApplied
                            <div class="bg-muted bg-small">
                                @if (_distribution.EffectiveMadThreshold > _distribution.FixedMadThreshold)
                                {
                                    <text>@T.BenfordThresholdRaised(_distribution.EffectiveMadThreshold / 2d)</text>
                                }
                                else
                                {
                                    <text>@T.BenfordThresholdStandard</text>
                                }
                            </div>
                        </td>
                        <td class="bg-num">@_distribution.EffectiveMadThreshold.ToString("F4")</td>
                    </tr>
                    <tr>
                        <td>@T.BenfordBand</td>
                        <td class="bg-num">@_distribution.Conformity</td>
                    </tr>
                    <tr>
                        <td>
                            @T.BenfordChiSquare
                            <div class="bg-muted bg-small">
                                @T.BenfordChiSquareNote
                            </div>
                        </td>
                        <td class="bg-num">
                            @_distribution.ChiSquare.ToString("F1")
                            <div class="bg-muted bg-small">crit. @_distribution.ChiSquareCriticalValue.ToString("F3")</div>
                        </td>
                    </tr>
                    <tr>
                        <td>@T.BenfordExcluded</td>
                        <td class="bg-num">@_distribution.ExcludedCount.ToString("N0")</td>
                    </tr>
                </tbody>
            </table>
        </section>

        <section class="bg-card">
            <h2>@T.BenfordPerDigit</h2>
            <div class="bg-table-wrap">
                <table class="bg-table">
                    <thead>
                        <tr>
                            <th>@T.ColDigit</th>
                            <th class="bg-num">@T.ColObserved</th>
                            <th class="bg-num">@T.ColExpected</th>
                            <th class="bg-num">@T.ColDeviation</th>
                            <th class="bg-num">@T.ColExcess</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var digit in _distribution.Digits)
                        {
                            <tr>
                                <td><strong>@digit.Digit</strong></td>
                                <td class="bg-num">
                                    @digit.ObservedProportion.ToString("P1")
                                    <div class="bg-muted bg-small">@digit.ObservedCount.ToString("N0")</div>
                                </td>
                                <td class="bg-num">
                                    @digit.ExpectedProportion.ToString("P1")
                                    <div class="bg-muted bg-small">@digit.ExpectedCount.ToString("N0")</div>
                                </td>
                                <td class="bg-num @(digit.DeviationPercentagePoints > 3 ? "bg-deviation-high" : "")">
                                    @digit.DeviationPercentagePoints.ToString("+0.0;-0.0;0.0") pts
                                </td>
                                <td class="bg-num">@digit.ExcessCount.ToString("+#,##0;-#,##0;0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <section class="bg-card">
        <h2>@T.BenfordReadingTitle</h2>
        <p class="bg-muted">
            @T.BenfordReadingBody
        </p>
        <p class="bg-muted">
            <a href="how-it-works">@T.BenfordMethodologyLink</a>
        </p>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "datasetId")]
    private Guid? DatasetId { get; set; }

    [SupplyParameterFromQuery(Name = "vendor")]
    private string? Vendor { get; set; }

    private BenfordDistributionDto? _distribution;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _distribution = await Sender.Send(new GetBenfordDistributionQuery(DatasetId, Vendor));
        }
        catch (BudgetGuard.Application.Common.Exceptions.NotFoundException)
        {
            _error = T.NoDatasetBody;
        }
    }
}
