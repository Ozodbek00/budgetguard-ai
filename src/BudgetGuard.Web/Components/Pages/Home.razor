@page "/"
@inject ISender Sender
@inject NavigationManager Navigation
@inject IUiText T

<PageTitle>BudgetGuard AI — @T.NavUpload</PageTitle>

<div class="bg-hero">
    <h1>@T.HeroTitle</h1>
    <p>
        @T.HeroBody
    </p>
</div>

<div class="bg-grid-2">
    <section class="bg-card">
        <h2>@T.DemoTitle</h2>
        <p class="bg-muted">
            @T.DemoBody
        </p>

        <button class="bg-btn bg-btn-primary" @onclick="LoadDemoAsync" disabled="@_isBusy">
            @(_isBusy && _busyAction == BusyAction.Demo ? T.DemoGenerating : T.DemoButton)
        </button>

        @if (_demoResult is not null)
        {
            <div class="bg-banner bg-banner-ok">
                <strong>@T.DemoReady</strong>
                @T.TransactionsAnalysed(_demoResult.RowCount)

                <details class="bg-details">
                    <summary>@T.DemoPlanted</summary>
                    <ul>
                        @foreach (var planted in _demoResult.PlantedAnomalies)
                        {
                            <li>@planted</li>
                        }
                    </ul>
                </details>
            </div>
        }
    </section>

    <section class="bg-card">
        <h2>@T.UploadTitle</h2>
        <p class="bg-muted">
            @T.UploadBody
        </p>

        <label class="bg-dropzone">
            <InputFile OnChange="OnFileSelectedAsync" accept=".csv,.xlsx" disabled="@_isBusy" />
            <span>@(_selectedFileName ?? T.UploadChooseFile)</span>
        </label>

        @if (_isBusy && _busyAction == BusyAction.Upload)
        {
            <p class="bg-muted">@T.UploadWorking</p>
        }

        @if (_uploadErrors.Count > 0)
        {
            <div class="bg-banner bg-banner-error">
                <strong>@T.UploadFailed</strong>
                <ul>
                    @foreach (var error in _uploadErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        @if (_uploadResult is not null)
        {
            <div class="bg-banner bg-banner-ok">
                <strong>@T.UploadAccepted(_uploadResult.RowsAccepted)</strong>

                @if (_uploadResult.RowsSkipped > 0)
                {
                    <text> @T.UploadSkipped(_uploadResult.RowsSkipped)</text>

                    <details class="bg-details">
                        <summary>@T.UploadWhySkipped</summary>
                        <ul>
                            @foreach (var warning in _uploadResult.Warnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                    </details>
                }
            </div>
        }
    </section>
</div>

@if (_datasets.Count > 0)
{
    <section class="bg-card">
        <h2>@T.StoredDatasets</h2>
        <table class="bg-table">
            <thead>
                <tr>
                    <th>@T.ColName</th>
                    <th>@T.ColSource</th>
                    <th class="bg-num">@T.ColRows</th>
                    <th>@T.ColUploaded</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dataset in _datasets)
                {
                    <tr>
                        <td>
                            @dataset.Name
                            @if (dataset.IsSyntheticDemo)
                            {
                                <span class="bg-tag bg-tag-synthetic">synthetic</span>
                            }
                        </td>
                        <td class="bg-muted">@dataset.SourceFileName</td>
                        <td class="bg-num">@dataset.RowCount.ToString("N0")</td>
                        <td class="bg-muted">@dataset.UploadedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                        <td>
                            <a class="bg-btn bg-btn-small" href="@($"report?datasetId={dataset.Id}")">@T.ActionAnalyse</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private const int MaxUploadMegabytes = 32;

    private enum BusyAction { None, Demo, Upload }

    private IReadOnlyList<DatasetSummaryDto> _datasets = [];
    private LoadDemoDatasetResult? _demoResult;
    private UploadDatasetResult? _uploadResult;
    private List<string> _uploadErrors = [];
    private string? _selectedFileName;
    private bool _isBusy;
    private BusyAction _busyAction = BusyAction.None;

    protected override async Task OnInitializedAsync() => await RefreshDatasetsAsync();

    private async Task RefreshDatasetsAsync() =>
        _datasets = await Sender.Send(new GetDatasetsQuery());

    private async Task LoadDemoAsync()
    {
        _isBusy = true;
        _busyAction = BusyAction.Demo;
        _uploadErrors = [];

        try
        {
            _demoResult = await Sender.Send(new LoadDemoDatasetCommand());
            await RefreshDatasetsAsync();
            Navigation.NavigateTo($"report?datasetId={_demoResult.DatasetId}");
        }
        finally
        {
            _isBusy = false;
            _busyAction = BusyAction.None;
        }
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _selectedFileName = file.Name;
        _uploadErrors = [];
        _uploadResult = null;
        _isBusy = true;
        _busyAction = BusyAction.Upload;

        try
        {
            await using var stream = file.OpenReadStream(MaxUploadMegabytes * 1024L * 1024L);

            // Buffered to a seekable stream first: the parsers need to read the
            // whole file, and Blazor's browser-backed stream does not support
            // the seeking ClosedXML performs on a workbook.
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;

            _uploadResult = await Sender.Send(new UploadDatasetCommand(buffer, file.Name));

            await RefreshDatasetsAsync();
            Navigation.NavigateTo($"report?datasetId={_uploadResult.DatasetId}");
        }
        catch (BudgetGuard.Application.Common.Exceptions.ValidationException ex)
        {
            _uploadErrors = ex.AllMessages.ToList();
        }
        catch (IOException ex)
        {
            _uploadErrors = [$"The file could not be read: {ex.Message}"];
        }
        finally
        {
            _isBusy = false;
            _busyAction = BusyAction.None;
        }
    }
}
