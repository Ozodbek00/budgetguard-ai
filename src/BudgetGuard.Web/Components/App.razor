@inject IUiText T

@* lang reflects the selected language rather than being hardcoded to "en":
   screen readers pick pronunciation from it, and it is what tells a browser
   whether to offer to translate the page. *@
<!DOCTYPE html>
<html lang="@T.LanguageTag">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    @* Only app.css is linked.

       The template also links Bootstrap and the scoped-CSS bundle
       (BudgetGuard.Web.styles.css). Neither is used here: the styling is
       hand-written in app.css, and there are no .razor.css files, so Blazor
       generates no bundle at all — leaving that link in place produced a 404
       and a console error on every page load. *@
    <link rel="stylesheet" href="@Assets["app.css"]" />

    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
