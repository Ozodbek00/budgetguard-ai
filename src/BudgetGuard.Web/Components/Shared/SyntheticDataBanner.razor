@inject IUiText T

@* Shown wherever synthetic demo data is being displayed.

   This is a correctness requirement, not decoration: the demo dataset contains
   deliberately planted fraud patterns, and a screenshot of a "Critical" finding
   against an invented vendor must never be mistakable for a real audit result.
   It is translated for the same reason — a warning nobody can read is not a
   warning. *@

@if (IsSyntheticDemo)
{
    <div class="bg-banner bg-banner-synthetic" role="status">
        @T.SyntheticBanner
    </div>
}

@code {
    /// <summary>Whether the dataset currently displayed came from the built-in generator.</summary>
    [Parameter]
    public bool IsSyntheticDemo { get; set; }
}
