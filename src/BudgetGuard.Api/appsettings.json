{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BudgetGuard": "Data Source=data/budgetguard.db"
  },

  "//": "Every detection threshold. Nothing in the engine is a hardcoded magic number; see docs/DETECTION_METHODOLOGY.md for the reasoning behind each default.",
  "Detection": {
    "Benford": {
      "MinimumSampleSize": 50,
      "MadNonConformityThreshold": 0.015,
      "MadCloseConformityThreshold": 0.006,
      "MadAcceptableConformityThreshold": 0.012,
      "ChiSquareCriticalValue": 15.507,
      "MinimumVendorSampleSize": 50,
      "NoiseFloorMultiple": 2.0
    },
    "ZScore": {
      "Threshold": 3.0,
      "ModifiedThreshold": 3.5,
      "Method": "ClassicZScore",
      "Transform": "Log10",
      "MinimumGroupSize": 8,
      "Groupings": [ "Vendor", "Category", "Department" ]
    },
    "VendorConcentration": {
      "SpendShareThreshold": 0.30,
      "ExpectedShareMultiple": 3.0,
      "ContractCountZThreshold": 2.0,
      "MinimumContractsForConcentration": 3,
      "MinimumVendorsInScope": 3,
      "MinimumTransactionsInScope": 10,
      "HighlyConcentratedHhi": 2500,
      "Scopes": [ "Category", "Department" ]
    },
    "Scoring": {
      "BenfordWeight": 1.0,
      "ZScoreWeight": 1.0,
      "VendorConcentrationWeight": 1.2,
      "CorroborationBonus": 0.15,
      "CriticalThreshold": 0.75,
      "HighThreshold": 0.50,
      "MediumThreshold": 0.25
    }
  }
}
